# Supabase
# Renseigne ces valeurs dans .env.local (jamais de secret ici).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry (optionnel)
# DSN publique : nécessaire pour capter les erreurs navigateur (client).
# Laisse vide tant qu'aucun projet Sentry n'est créé : le SDK est alors inactif.
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (optionnel)
# Identifiants PUBLICS (embarqués dans le bundle navigateur, pas des secrets).
# Laisse vide tant qu'aucun projet PostHog n'est créé : le SDK est alors inactif.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
