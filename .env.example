# =============================================================================
# SAAS STARTER V2 — Variables d'environnement
# =============================================================================
# Copie ce fichier vers .env.local et renseigne les valeurs.
# JAMAIS de vrais secrets dans ce fichier (ni dans Git).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (requis)
# -----------------------------------------------------------------------------
# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Clé publishable (publique, embarquée dans le bundle navigateur)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE de service (contourne RLS). Serveur UNIQUEMENT :
# jamais importée dans du code exposé au client (email outbox, jobs, cron).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Email (requis pour envois réels)
# -----------------------------------------------------------------------------
# Provider : "dev" (logs console) | "resend" (envoi réel via Resend)
# Si non défini : "resend" si RESEND_API_KEY présente, sinon "dev"
EMAIL_PROVIDER=
# Clé API Resend (requise si provider=resend)
RESEND_API_KEY=
# Expéditeur (email)
EMAIL_FROM=
# Nom expéditeur (optionnel)
EMAIL_FROM_NAME=
# Timeout d'envoi ms (défaut: 10000)
EMAIL_SEND_TIMEOUT_MS=
# Tentatives d'envoi (défaut: 3)
EMAIL_SEND_ATTEMPTS=

# -----------------------------------------------------------------------------
# Cron / Jobs (requis en production)
# -----------------------------------------------------------------------------
# Secret pour authentifier les appels cron (Bearer token).
# Doit être une chaîne aléatoire longue (ex. `openssl rand -hex 32`).
# Requis en production pour /api/cron/run
CRON_SECRET=

# Activer les workers jobs (défaut: true)
JOBS_WORKERS_ENABLED=
# Batch size par défaut (défaut: 10)
JOBS_DEFAULT_BATCH_SIZE=
# Timeout handler ms (défaut: 30000)
JOBS_DEFAULT_HANDLER_TIMEOUT_MS=
# Max attempts par défaut (défaut: 3)
JOBS_DEFAULT_MAX_ATTEMPTS=

# -----------------------------------------------------------------------------
# App Branding (public — embarqué dans le bundle)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_APP_TAGLINE=
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Auth (optionnel — valeurs par défaut sûres)
# -----------------------------------------------------------------------------
# Durée session secondes (défaut: 3600)
AUTH_SESSION_DURATION=
# Activer inscription (défaut: true)
AUTH_ENABLE_SIGNUP=
# Activer confirmation email (défaut: true)
AUTH_ENABLE_EMAIL_CONFIRMATION=
# Redirection post-login (défaut: /dashboard)
AUTH_LOGIN_REDIRECT=
# Redirection post-signup (défaut: /dashboard)
AUTH_SIGNUP_REDIRECT=

# -----------------------------------------------------------------------------
# Rate Limiting (optionnel)
# -----------------------------------------------------------------------------
# Activer (défaut: true)
RATE_LIMIT_ENABLED=
# Store: "memory" | "redis" (défaut: memory)
RATE_LIMIT_STORE=

# -----------------------------------------------------------------------------
# Monitoring — Sentry (optionnel)
# -----------------------------------------------------------------------------
# DSN publique Sentry (requise pour capturer erreurs navigateur)
NEXT_PUBLIC_SENTRY_DSN=
# Sample rate traces 0-1 (défaut: 0.1)
SENTRY_TRACES_SAMPLE_RATE=
# Organisation Sentry (requis pour upload source maps en CI)
SENTRY_ORG=
# Projet Sentry (requis pour upload source maps en CI)
SENTRY_PROJECT=
# Auth token Sentry (requis pour upload source maps en CI, jamais exposé côté client)
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Analytics — PostHog (optionnel)
# -----------------------------------------------------------------------------
# Clé publique PostHog
NEXT_PUBLIC_POSTHOG_KEY=
# Host PostHog (optionnel, défaut: https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=

# -----------------------------------------------------------------------------
# Storage (optionnel)
# -----------------------------------------------------------------------------
# Taille max upload bytes (défaut: 10485760 = 10MB)
STORAGE_MAX_UPLOAD_SIZE=
# Bucket public (défaut: saas_public)
STORAGE_PUBLIC_BUCKET=
# Bucket privé (défaut: saas_private)
STORAGE_PRIVATE_BUCKET=

# -----------------------------------------------------------------------------
# Feature Flags (optionnel — défaut: true sauf webhooks)
# -----------------------------------------------------------------------------
FEATURE_NOTIFICATIONS=
FEATURE_EXPORTS=
FEATURE_WEBHOOKS=
FEATURE_BILLING=
FEATURE_STORAGE=
FEATURE_INVITATIONS=
FEATURE_TEAMS=

# -----------------------------------------------------------------------------
# Limites (optionnel — défauts raisonnables)
# -----------------------------------------------------------------------------
LIMIT_MAX_ORGS_PER_USER=
LIMIT_MAX_MEMBERS_PER_ORG=
LIMIT_MAX_PENDING_INVITATIONS=
LIMIT_MAX_EXPORTS_PER_DAY=
LIMIT_MAX_EXPORT_ROWS=