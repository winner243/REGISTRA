meta {
  name: Server Action — resetPassword (password mismatch)
  type: http
  seq: 80
  doc: |
    Teste resetPassword avec des mots de passe différents.
    Nécessite une session active (token de reset password).
}

vars {
  base_url: http://localhost:3000
  action_id_reset: 605a9ed23730e72f51d67407e26f83a0889d30e01c
  test_password: NewPassword123!
  wrong_confirm: DifferentPassword999!
}

post {
  url: "{{base_url}}/reset-password"
  headers: {
    Next-Action: "{{action_id_reset}}"
    Accept: text/x-component
  }
  body: multipart/form-data {
    key: "0"
    value: "{{\"root\":\"$@1\",\"1\":\"{\\\"password\\\":\\\"{{test_password}}\\\",\\\"confirmPassword\\\":\\\"{{wrong_confirm}}\\\"}\"}"
    type: text/plain
  }
}

tests {
  assert(res.status, "Status should be 200", res.status === 200)
  assert("Should NOT redirect (validation error)", !res.headers.hasOwnProperty("x-action-redirect"))
}
