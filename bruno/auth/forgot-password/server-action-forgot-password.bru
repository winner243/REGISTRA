meta {
  name: Server Action — forgotPassword (success)
  type: http
  seq: 70
  doc: |
    Teste l'action forgotPassword.
    Retourne toujours le même message quel que soit l'email
    (prévention de l'énumération d'utilisateurs).
}

vars {
  base_url: http://localhost:3000
  action_id_forgot: 6013d7a13cdea4f7a8cf92b8076d08d0a4145f1727
  test_email: {{your_test_email}}
}

post {
  url: "{{base_url}}/forgot-password"
  headers: {
    Next-Action: "{{action_id_forgot}}"
    Accept: text/x-component
  }
  body: multipart/form-data {
    key: "0"
    value: "{{\"root\":\"$@1\",\"1\":\"{\\\"email\\\":\\\"{{test_email}}\\\"}\"}"
    type: text/plain
  }
}

tests {
  assert(res.status, "Status should be 200", res.status === 200)
  assert("Should NOT redirect", !res.headers.hasOwnProperty("x-action-redirect"))
  const ct = res.headers["content-type"] || ""
  assert("Content-Type should be text/x-component", ct.includes("text/x-component"))
}
