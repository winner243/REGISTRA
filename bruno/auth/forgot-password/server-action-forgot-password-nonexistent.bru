meta {
  name: Server Action — forgotPassword (nonexistent email)
  type: http
  seq: 71
  doc: |
    Vérifie que forgotPassword retourne le même message
    même pour un email inexistant (anti-enumération).
}

vars {
  base_url: http://localhost:3000
  action_id_forgot: 6013d7a13cdea4f7a8cf92b8076d08d0a4145f1727
  test_email: ghost-{{timestamp}}@nowhere.com
}

post {
  url: "{{base_url}}/forgot-password"
  headers: {
    Next-Action: "{{action_id_forgot}}"
    Accept: text/x-component
  }
  body: multipart/form-data {
    key: "0"
    value: "{{\"root\":\"$@1\",\"1\":\"{\\\"email\\\":\\\"{{test_email}}\\\"}\"}"
    type: text/plain
  }
}

tests {
  assert(res.status, "Status should be 200", res.status === 200)
  assert("Should NOT reveal that user doesn't exist", !res.headers.hasOwnProperty("x-action-redirect"))
}
