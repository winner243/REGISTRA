meta {
  name: Server Action — login (wrong credentials)
  type: http
  seq: 51
  doc: |
    Teste la validation d'identifiants incorrects.
    Devrait retourner une erreur dans le Flight format.
}

vars {
  base_url: http://localhost:3000
  action_id_login: 60a204282119020ccbb93dd1c64c000af939475040
  test_email: {{your_test_email}}
  test_password: WrongPassword999!
}

post {
  url: "{{base_url}}/login"
  headers: {
    Next-Action: "{{action_id_login}}"
    Accept: text/x-component
  }
  body: multipart/form-data {
    key: "0"
    value: "{{\"root\":\"$@1\",\"1\":\"{\\\"email\\\":\\\"{{test_email}}\\\",\\\"password\\\":\\\"{{test_password}}\\\"}\"}"
    type: text/plain
  }
}

tests {
  assert(res.status, "Status should be 200", res.status === 200)
  const ct = res.headers["content-type"] || ""
  assert("Content-Type should be text/x-component", ct.includes("text/x-component"))
  assert("Should NOT redirect (no x-action-redirect)", !res.headers.hasOwnProperty("x-action-redirect"))
}
