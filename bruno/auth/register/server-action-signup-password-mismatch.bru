meta {
  name: Server Action — signUp (password mismatch)
  type: http
  seq: 61
  doc: |
    Teste la validation Zod : password !== confirmPassword.
    Le schéma signUpSchema utilise .refine() pour vérifier la correspondance.
}

vars {
  base_url: http://localhost:3000
  action_id_signup: 60b7a2108a9717b9fd0aca8dba5744c9c802797d08
  test_email: test-mismatch-{{timestamp}}@example.com
  test_password: TestPassword123!
  wrong_confirm: DifferentPassword999!
}

post {
  url: "{{base_url}}/register"
  headers: {
    Next-Action: "{{action_id_signup}}"
    Accept: text/x-component
  }
  body: multipart/form-data {
    key: "0"
    value: "{{\"root\":\"$@1\",\"1\":\"{\\\"email\\\":\\\"{{test_email}}\\\",\\\"password\\\":\\\"{{test_password}}\\\",\\\"confirmPassword\\\":\\\"{{wrong_confirm}}\\\"}\"}"
    type: text/plain
  }
}

tests {
  assert(res.status, "Status should be 200", res.status === 200)
  assert("Should NOT redirect (validation error)", !res.headers.hasOwnProperty("x-action-redirect"))
}
