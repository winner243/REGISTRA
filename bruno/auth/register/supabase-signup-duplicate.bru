meta {
  name: Supabase Direct — Sign Up (email already registered)
  type: http
  seq: 11
}

vars {
  supabase_url: http://localhost:54321
  supabase_anon_key: {{paste_your_anon_key_here}}
  test_email: duplicate@example.com
  test_password: TestPassword123!
}

post {
  url: "{{supabase_url}}/auth/v1/signup"
  headers: {
    Content-Type: application/json
    apikey: "{{supabase_anon_key}}"
    Authorization: "Bearer {{supabase_anon_key}}"
  }
  body: json {
    "email": "{{test_email}}",
    "password": "{{test_password}}"
  }
}

tests {
  assert(res.status, "Status should be 200 or 400", res.status === 200 || res.status === 400)

  if (res.status === 200 && res.body.user && res.body.user.identities && res.body.user.identities.length === 0) {
    assert("Empty identities means user already exists", true)
  }

  if (res.status === 400) {
    assert("Should contain error message", res.body.hasOwnProperty("msg") || res.body.hasOwnProperty("error_description"))
  }
}
